# Production loads FABRIC_USERNAME, FABRIC_PASSWORD and APP_SECRET from
# systemd service credentials; environment values remain a development fallback.
FABRIC_HOST=https://localhost:8100/api/v1
FABRIC_USERNAME=
FABRIC_PASSWORD=
FABRIC_CHAINCODE_ID=1
# Service identity used only for read/query calls. User mutations ignore this key.
FABRIC_KEY_ID=6
# Local SQLite registry: userID -> ChainLaunch key ID + public certificate metadata.
# Store on a persistent local filesystem; backend enforces mode 0600.
IDENTITY_REGISTRY_DB=identity-registry.local.sqlite3
ENFORCE_FABRIC_IDENTITY_LOGIN=1
# ChainLaunch organization used when Admin approves a provisioning request.
FABRIC_IDENTITY_ORGANIZATION_ID=1
ADMIN_OWNER_ID=U001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://canhhtungg.github.io
LOGIN_FAILURE_LIMIT=8
LOGIN_FAILURE_WINDOW=600
BACKEND_HOST=127.0.0.1
APP_SECRET=
AUTH_TOKEN_MAX_AGE=28800
AUTH_CREDENTIALS_FILE=
ROLE_PERMISSIONS_FILE=
AUTH_STATE_FILE=
DEFAULT_INITIAL_PASSWORD=12345678
FLASK_DEBUG=0

# Browser session hardening. Production cross-site frontend requires Secure + SameSite=None.
AUTH_COOKIE_NAME=assetchain_session
AUTH_COOKIE_SECURE=1
AUTH_COOKIE_SAMESITE=None
AUTH_RETURN_BEARER_TOKEN=0

# Shared SQLite state removes per-worker rate-limit/idempotency gaps on one host.
# Put this on a persistent local filesystem writable only by the backend service.
SECURITY_STATE_DB=security-state.local.sqlite3
IDEMPOTENCY_TTL=86400

# Optional TOTP MFA. JSON format: {"username":"BASE32SECRET"}; chmod 0600.
# Set required roles only after every account in those roles has a secret.
# Prefer the MFA_TOTP_SECRETS systemd credential in production.
MFA_TOTP_SECRETS_FILE=
MFA_REQUIRED_ROLES=admin,manager

# External-chaincode runtime only (not backend): disabled when any value is empty.
# Set identically on every peer only for the one-time bootstrap, then remove after
# BootstrapAdminIdentity succeeds. Fingerprint is lowercase SHA-256 certificate DER.
IDENTITY_BOOTSTRAP_USER_ID=
IDENTITY_BOOTSTRAP_MSP_ID=
IDENTITY_BOOTSTRAP_CERT_FINGERPRINT=

# Keep false until the committed chaincode definition includes collections_config.json.
# ChainLaunch definition API 2026.9 currently omits collection bytes.
USER_CREDENTIAL_PDC_ENABLED=false
