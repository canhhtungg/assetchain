[Service]
# Create these *.cred files locally with systemd-creds; never commit them.
# This drop-in is a template only and does not replace credentials.conf automatically.
LoadCredentialEncrypted=FABRIC_USERNAME:%h/.config/assetchain/credentials/FABRIC_USERNAME.cred
LoadCredentialEncrypted=FABRIC_PASSWORD:%h/.config/assetchain/credentials/FABRIC_PASSWORD.cred
LoadCredentialEncrypted=APP_SECRET:%h/.config/assetchain/credentials/APP_SECRET.cred
LoadCredentialEncrypted=MFA_TOTP_SECRETS:%h/.config/assetchain/credentials/MFA_TOTP_SECRETS.cred
